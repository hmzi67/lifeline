# Read by docker compose (docker-compose.yml, copied from docker-compose.example.yml).
# Copy to .env next to it and fill in real values; .env is git-ignored.

POSTGRES_USER=lifeline
# Long and random, e.g. `openssl rand -hex 24` (hex needs no escaping in the URL below).
POSTGRES_PASSWORD=
POSTGRES_DB=lifeline

# Must use the same user, password and database as above; the host is the postgres service.
# URL-encode the password if it contains characters other than letters, digits, - or _.
DATABASE_URL=postgresql://lifeline:CHANGE_ME@postgres:5432/lifeline?connection_limit=10&pool_timeout=20

# Baked into the client bundle at build time (a publishable key, not a secret).
VITE_STRIPE_PUBLISHABLE_KEY=
